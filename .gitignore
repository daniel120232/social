# 환경 변수 파일 (보안 필수)
.env
*.env.local

# 의존성 패키지
node_modules/
/vendor/

# 빌드 결과물
dist/
build/
*.pyc

# 운영체제 및 로그 파일
.DS_Store
*.log

# txt 파일은 GitHub에 올리지 않음
*.txt

/mp3/
/pdf/

# ── 화이트리스트: 아래 폴더의 md 파일만 업로드 ──
# 먼저 루트의 모든 항목을 무시
/*

# 예외: .gitignore 와 과목 폴더
!.gitignore
!과학/
!국어/
!사회/
!영어/
!수학/

# 과목 폴더 내부에서는 md 파일만 허용
과학/**/*
!과학/**/
!과학/**/*.md
국어/**/*
!국어/**/
!국어/**/*.md
사회/**/*
!사회/**/
!사회/**/*.md
영어/**/*
!영어/**/
!영어/**/*.md
수학/**/*
!수학/**/
!수학/**/*.md
